AZURE_STORAGE_CONNECTION_STR="String here"
CONTAINER_NAME="container name here"

file_path="File path to the uploading folder"
file_name="" #You can keep this empty

AZURE_SEARCH_SERVICE_NAME=   # just the name, not the full URL
AZURE_SEARCH_INDEX_NAME="Rag search name here eg (rag-xxxxxxxxxxxxxx)"
AZURE_SEARCH_API_KEY="Api key here"

# The name of the field in your index that holds the document text.
# Check your index schema in the Portal — often "content" or "chunk".
AZURE_SEARCH_CONTENT_FIELD=chunk #you can keep this like this

# How many chunks to retrieve per query
AZURE_SEARCH_TOP_K=10

# ── Azure OpenAI (Azure AI Foundry) ──────────────────────────────────────────
# Find these in Azure AI Foundry → your project → Settings → Connections
AZURE_OPENAI_ENDPOINT="endpoint here from foundry"  #set-this-from-foundry-model-details
AZURE_OPENAI_API_KEY=  #set-this-from-foundry-model-details
AZURE_OPENAI_DEPLOYMENT=   #gpt-5-mini   # the deployment name you gave the model in Foundry
AZURE_OPENAI_API_VERSION=2024-12-01-preview
